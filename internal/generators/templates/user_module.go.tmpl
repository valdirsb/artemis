package modules

import (
	"fmt"

	"{{.Name}}/internal/modules/user/adapters"
	"{{.Name}}/internal/modules/user/adapters/grpc"
	"{{.Name}}/internal/modules/user/adapters/http"
	"{{.Name}}/internal/modules/user/application/commands"
	"{{.Name}}/internal/modules/user/application/queries"
	"{{.Name}}/internal/modules/user/application/services"
	"{{.Name}}/internal/modules/user/repository"
	"{{.Name}}/pkg/container"
	"{{.Name}}/pkg/events"

	"github.com/gin-gonic/gin"
	grpclib "google.golang.org/grpc"
	"gorm.io/gorm"
)

// UserModule implementa o módulo de usuários com auto-registro
type UserModule struct {
	db       *gorm.DB
	eventBus *events.EventBus
}

// NewUserModule cria uma nova instância do módulo User
func NewUserModule(db *gorm.DB, eventBus *events.EventBus) *UserModule {
	return &UserModule{
		db:       db,
		eventBus: eventBus,
	}
}

// Name retorna o nome do módulo
func (m *UserModule) Name() string {
	return "user"
}

// Register registra todos os componentes do módulo no registry
func (m *UserModule) Register(registry *container.ModuleRegistry) error {
	fmt.Printf("🔧 Registering module: %s\n", m.Name())

	// 1. Registrar Repository
	userRepo := repository.NewMySQLUserRepository(m.db)
	registry.RegisterRepository("user", userRepo)

	// 2. Registrar Password Hasher
	passwordHasher := adapters.NewArgon2PasswordHasher()
	registry.Container().Register("user.password_hasher", passwordHasher)

	// 3. Registrar Logger
	logger := adapters.NewStructuredLogger()
	registry.Container().Register("user.logger", logger)

	// 4. Registrar Email Service (mock para desenvolvimento)
	emailService := adapters.NewMockEmailService()
	registry.Container().Register("user.email_service", emailService)

	// 5. Registrar TypedEventPublisher
	typedPublisher := events.NewTypedEventPublisher(m.eventBus)
	registry.Container().Register("user.typed_publisher", typedPublisher)

	// 6. Criar Command Handlers (usar eventBus original para compatibilidade)
	createUserHandler := commands.NewCreateUserHandler(userRepo, passwordHasher, emailService, m.eventBus, logger)
	updateUserHandler := commands.NewUpdateUserHandler(userRepo, logger)
	deleteUserHandler := commands.NewDeleteUserHandler(userRepo, m.eventBus, logger)
	validateCredentialsHandler := commands.NewValidateCredentialsHandler(userRepo, passwordHasher, logger)

	// 7. Criar Query Handlers
	getUserHandler := queries.NewGetUserHandler(userRepo, logger)
	listUsersHandler := queries.NewListUsersHandler(userRepo, logger)
	getUserByEmailHandler := queries.NewGetUserByEmailHandler(userRepo, logger)

	// 8. Registrar Application Service
	userAppService := services.NewUserApplicationService(
		createUserHandler,
		updateUserHandler,
		deleteUserHandler,
		validateCredentialsHandler,
		getUserHandler,
		listUsersHandler,
		getUserByEmailHandler,
	)
	registry.RegisterApplicationService("user", userAppService)

	// 9. Registrar HTTP Handler
	httpHandler := http.NewUserHTTPHandler(userAppService)
	registry.RegisterHTTPHandler("user", &userHTTPHandlerAdapter{handler: httpHandler})

	// 10. Registrar gRPC Handler
	grpcHandler := grpc.NewUserGRPCHandler(userAppService, userRepo)
	registry.RegisterGRPCService(&userGRPCServiceAdapter{handler: grpcHandler})

	fmt.Printf("✅ Module %s registered successfully\n", m.Name())
	return nil
}

// userHTTPHandlerAdapter adapta o HTTP handler para a interface do registry
type userHTTPHandlerAdapter struct {
	handler *http.UserHTTPHandler
}

func (a *userHTTPHandlerAdapter) RegisterRoutes(router *gin.RouterGroup) {
	users := router.Group("/users")
	{
		users.POST("", a.handler.CreateUser)
		users.GET("/:id", a.handler.GetUser)
		users.PUT("/:id", a.handler.UpdateUser)
		users.DELETE("/:id", a.handler.DeleteUser)
		users.POST("/validate", a.handler.ValidateUser)
		// users.GET("", a.handler.ListUsers) // TODO: Implementar ListUsers no handler
	}
}

// userGRPCServiceAdapter adapta o gRPC handler para a interface do registry
type userGRPCServiceAdapter struct {
	handler *grpc.UserGRPCHandler
}

func (a *userGRPCServiceAdapter) RegisterService(server *grpclib.Server) {
	a.handler.RegisterWithServer(server)
}