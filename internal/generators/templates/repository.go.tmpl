func New{{.ModuleName}}Repository(db *gorm.DB) *{{.ModuleName}}Repository {
    return &{{.ModuleName}}Repository{db: db}
}

func (r *{{.ModuleName}}Repository) Create(ctx context.Context, entity *contracts.{{.ModuleName}}) error {
