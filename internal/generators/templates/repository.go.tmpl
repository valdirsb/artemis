func (r *{{.ModuleName}}Repository) Update(ctx context.Context, entity *contracts.{{.ModuleName}}) error {
    return r.db.WithContext(ctx).Save(entity).Error
}

func (r *{{.ModuleName}}Repository) Delete(ctx context.Context, id string) error {
    return r.db.WithContext(ctx).Delete(&contracts.{{.ModuleName}}{}, id).Error
}

func (r *{{.ModuleName}}Repository) FindAll(ctx context.Context) ([]*contracts.{{.ModuleName}}, error) {
    var entities []*contracts.{{.ModuleName}}
    if err := r.db.WithContext(ctx).Find(&entities).Error; err != nil {
