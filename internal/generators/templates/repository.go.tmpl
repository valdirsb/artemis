func (r *{{.ModuleName}}Repository) FindByID(ctx context.Context, id string) (*contracts.{{.ModuleName}}, error) {
    var entity contracts.{{.ModuleName}}
    if err := r.db.WithContext(ctx).First(&entity, "id = ?", id).Error; err != nil {
