package interfaces

import "{{.Name}}/pkg/container"

// Module representa um módulo que pode se auto-registrar
type Module interface {
	// Name retorna o nome do módulo
	Name() string

	// Register registra todos os componentes do módulo no registry
	Register(registry *container.ModuleRegistry) error
}

// ModuleConfig contém configurações comuns para módulos
type ModuleConfig struct {
	Name    string
	Enabled bool
	Config  map[string]interface{}
}